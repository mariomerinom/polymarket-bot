# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Trading (Part 6) ──────────────────────────────────────────────────────────
# Set TRADING_ENABLED=true to place real orders. Default: false (paper mode).
TRADING_ENABLED=false
BET_SIZE=25
DAILY_LOSS_LIMIT=300
MIN_CONVICTION=3

# Polymarket CLOB (required for live trading only)
# SDK derives API creds from the private key via EIP-712 signing.
# POLYMARKET_PRIVATE_KEY=0x...   # Polygon wallet private key (needs USDC.e approval)
# POLYMARKET_PROXY_ADDRESS=0x... # Polymarket proxy wallet (from profile dropdown on polymarket.com)
#                                # If set, uses GNOSIS_SAFE signing (type 2). If unset, uses EOA (type 0).
